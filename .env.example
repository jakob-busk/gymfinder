# Kopiér til .env og udfyld med værdierne fra Firebase-konsollen
# (Projektindstillinger → Generelt → Dine apps → Web-app). .env må aldrig committes.
# Står der stadig <...>-pladsholdere, starter appen med eksempeldata og uden login.
EXPO_PUBLIC_FIREBASE_API_KEY=<api-noegle>
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=<projekt-id>.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=<projekt-id>
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=<projekt-id>.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
EXPO_PUBLIC_FIREBASE_APP_ID=<app-id>
# Står øverst på Realtime Database-siden i konsollen
EXPO_PUBLIC_FIREBASE_DB_URL=https://<projekt-id>-default-rtdb.europe-west1.firebasedatabase.app

# Ronnie (Spørg Ronnie): OpenAI-nøgle fra platform.openai.com → API keys. Den ender i app-bundlen,
# så giv projektet en lav forbrugsgrænse (Settings → Limits). Uden nøgle viser Spørg Ronnie en
# besked i stedet for chatten.
EXPO_PUBLIC_OPENAI_API_KEY=<openai-noegle>

# Prisalarmer (push): EAS-projektets id, som Expo push-tokenet hører til. Kør `npx eas init` (gratis
# Expo-konto), eller kopiér id'et fra expo.dev → projektet → Overview. Ligger det allerede i
# app.json (extra.eas.projectId efter `eas init`), bruges det, og denne linje kan udelades.
# Uden id gemmes Prisalarmer stadig, men der hentes intet push-token.
EXPO_PUBLIC_EAS_PROJECT_ID=<eas-projekt-id>
