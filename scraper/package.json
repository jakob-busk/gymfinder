{
  "name": "gymfinder-scraper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env seed.mjs",
    "seed:dry-run": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON seed.mjs --dry-run",
    "scrape": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env index.mjs",
    "scrape:dry-run": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env index.mjs --dry-run",
    "verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON verify.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test",
    "verify:loop": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON verifyLoop.mjs",
    "verify:puregym": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON verifyPuregym.mjs",
    "verify:fitnessx": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON verifyFitnessx.mjs"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0"
  }
}
