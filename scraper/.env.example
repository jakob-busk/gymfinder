# Kopiér til scraper/.env for at køre seed/scraper lokalt. .env må aldrig committes.
# I GitHub Actions ligger de samme værdier som repository secrets.
# Service account: Firebase-konsollen → Projektindstillinger → Service accounts →
# "Generate new private key". Indsæt hele JSON-filen på én linje.
FIREBASE_SERVICE_ACCOUNT=<service-account-json-paa-en-linje>
FIREBASE_DATABASE_URL=https://<projekt-id>-default-rtdb.europe-west1.firebasedatabase.app
